package furzefield;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.Scanner;

import java.util.ArrayList;
import java.util.List;

public class MainApp
{

	    public void start(int userId)
	    {

	        BookingManager bookingManager = new BookingManager();
	        Lessons les = new Lessons();

	        Scanner sc = new Scanner(System.in);

	        while (true)
	        {
	            System.out.println("Your Member ID is: " + userId+"\n");
	            System.out.println("1. Book lesson");
	            System.out.println("2. Change/Cancel booking");
	            System.out.println("3. Attend lesson");
	            System.out.println("4. Show lesson report");
	            System.out.println("5. Show income report");
	            System.out.println("6. Exit");

	            System.out.print("Choose option: ");
	            int choice = sc.nextInt();
	            sc.nextLine();

	            if (choice == 1)
	            {

	                System.out.println("1. View Timetable by Day (Saturday/Sunday)");
	                System.out.println("2. View Timetable by Exercise Type");

	                int option = sc.nextInt();
	                sc.nextLine();

	                if (option == 1)
	                {
	                    System.out.print("Enter Day: ");
	                    String day = sc.nextLine();
	                    les.showLessons("SELECT * FROM lessons WHERE lesson_day LIKE ?", day);
	                    handleBooking(sc, userId, bookingManager);
	                }
	                else if (option == 2)
	                {
	                    System.out.print("Enter Exercise (Yoga, Zumba, etc.): ");
	                    String type = sc.nextLine();
	                    les.showLessons("SELECT * FROM lessons WHERE exercise_type LIKE ?", type);
	                    handleBooking(sc, userId, bookingManager);
	                }

	            }
				else if (choice == 2)
	            {
	                
	                System.out.println("\n--- Your Active Bookings ---");
	               
	                
	                if (!showModifiedBookings(userId))
	                {
	                    System.out.println("Returning to main menu...\n");
	                    continue;
	                }

	                System.out.print("\nEnter the Booking ID you want to modify (or 0 to go back): ");
	                int bookingId = sc.nextInt();
	                sc.nextLine();

	                if (bookingId != 0)
	                {
	                    System.out.println("\nWhat would you like to do with Booking #" + bookingId + "?");
	                    System.out.println("1. Change to a different lesson");
	                    System.out.println("2. Cancel this booking");
	                    System.out.print("Selection: ");
	                    
	                    int subOption = sc.nextInt();
	                    sc.nextLine();

	                    if (subOption == 1)
	                    {
	                        
	                        System.out.println("\n--- Available Timetable ---");
	                        les.showLessons("SELECT * FROM lessons", null); 
	                        
	                        System.out.print("\n Enter the NEW Lesson ID: \n");
	                        String input = sc.next();

	                        if (input.startsWith("L") || input.startsWith("l"))
	                        {
	                            input = input.substring(1);
	                        }

	                        int newLessonId = Integer.parseInt(input);

	                        
	                        bookingManager.changeBooking(userId, bookingId, newLessonId);
	                    } 
	                    else if (subOption == 2)
	                    {
	                        
	                        bookingManager.cancelBooking(userId, bookingId);
	                    }
	                    else
	                    {
	                        System.out.println("Invalid option. Returning to main menu.");
	                    }
	                }
	            }
				else if (choice == 3)
	            {
	                System.out.println("\n--- Attend a Lesson ---");
	                
	                
	                if (!showAttendBookings(userId))
	                {
	                    System.out.println("Returning to main menu...\n");
	                    continue; 
	                }

	                System.out.print("\nEnter the Booking ID you are attending: ");
	                while (!sc.hasNextInt())
	                {
	                    System.out.println("Invalid ID. Please enter a number.");
	                    sc.next();
	                }
	                int bId = sc.nextInt();
	                sc.nextLine(); 

	                
	                int userRating = 0;
	                while (userRating < 1 || userRating > 5)
	                {
	                    System.out.println("\nHow satisfied were you with the lesson?");
	                    System.out.println("1: Very Dissatisfied");
	                    System.out.println("2: Dissatisfied");
	                    System.out.println("3: Ok");
	                    System.out.println("4: Satisfied");
	                    System.out.println("5: Very Satisfied");
	                    System.out.print("Select (1-5): ");
	                    
	                    if (sc.hasNextInt())
	                    {
	                        userRating = sc.nextInt();
	                        if (userRating < 1 || userRating > 5)
	                        {
	                            System.out.println("Error: Please enter a number between 1 and 5.");
	                        }
	                    }
	                    else
	                    {
	                        System.out.println("Invalid input. Please enter a number.");
	                        sc.next(); 
	                    }
	                }
	                sc.nextLine(); 

	                System.out.print("Write a short review of the lesson: ");
	                String userComment = sc.nextLine();

	                
	                boolean success = les.attendLesson(userId, bId, userRating, userComment);
	                
	                if (success)
	                {
	                    System.out.println("\nSuccess: Attendance confirmed and review saved!");
	                }
	                else
	                {
	                    System.out.println("\nError: Could not process attendance.");
	                    System.out.println("Make sure the Booking ID belongs to you and hasn't been attended yet.");
	                }
	            }
	        }
	    }
	    
	    
	    
	    
	    public void handleBooking(Scanner sc, int mbId, BookingManager bm)
	    {
	    	System.out.print("\nEnter Lesson ID to book\n");
	        String input = sc.next();
	        
	        if (input.startsWith("L") || input.startsWith("l"))
	        {
	            input = input.substring(1);
	        }

	        int lsnId = Integer.parseInt(input);

			String result = bm.bookLesson(mbId, lsnId);

			switch (result)
			{
			    case "SUCCESS": System.out.println("\nSuccess: Booking confirmed!");
			    break;
			        
			    case "ALREADY_BOOKED": System.out.println("\nError: You have already booked this specific lesson.");
			    break;
			        
			    case "FULL": System.out.println("\nError: This lesson is already full (Max 4 students only).");
			    break;
			        
			    case "TIME_CONFLICT": System.out.println("\nError: Time conflict! You already have a lesson at this time.");
			    break;
			        
			    case "INSERT_FAILED": System.out.println("\nError: The booking could not be saved to the database.");
			        break;
			        
			    case "DB_ERROR":  System.out.println("\nError: Database connection issue. Please try again later.");
			    break;
			        
			    default: System.out.println("\nError: An unexpected issue occurred.");
			    break;
			}
	    }




         public boolean showModifiedBookings(int memberId)
	    {
	        
	        String sql = "SELECT b.booking_id, l.exercise_type, l.lesson_day, l.time_slot, b.status " +
	                     "FROM bookings b " +
	                     "JOIN lessons l ON b.lesson_id = l.lesson_id " +
	                     "WHERE b.member_id = ? AND b.status IN ('booked')";

	        try (Connection con = DatabaseConnection.connect();
	             PreparedStatement ps = con.prepareStatement(sql))
	        {

	            ps.setInt(1, memberId);
	            ResultSet rs = ps.executeQuery();

	            boolean found = false;
	            
	            System.out.printf("%-12s %-15s %-12s %-12s %-10s%n", 
	                              "Booking ID", "Exercise", "Day", "Time", "Status");
	            System.out.println("------------------------------------------------------------------");

	            while (rs.next()) {
	                found = true;
	                System.out.printf("%-12d %-15s %-12s %-12s %-10s%n",
	                                  rs.getInt("booking_id"),
	                                  rs.getString("exercise_type"),
	                                  rs.getString("lesson_day"),
	                                  rs.getString("time_slot"),
	                                  rs.getString("status"));
	            }

	            if (!found)
	            {
	                System.out.println("No active bookings found for your account.");
	                return false;
	            }
	            return true;
	        }
	        catch (SQLException e)
	        {
	            System.out.println("Error loading bookings: " + e.getMessage());
	            return false;
	        }

	    }
}

